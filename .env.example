# Copy this file to .env and fill in real values. Never commit .env.
# Only variables that the current phase actually uses are listed here.

# Which environment the app runs in: local, test or production.
APP_ENV=local

# Postgres connection string used by the API.
# The defaults match infra/docker-compose.yml for local development only.
DATABASE_URL=postgresql://groundtruth:groundtruth@localhost:5434/groundtruth

# Credentials used by docker compose to create the local database.
POSTGRES_USER=groundtruth
POSTGRES_PASSWORD=groundtruth
POSTGRES_DB=groundtruth

# Host port for Postgres. 5434 avoids clashes with other local Postgres
# servers on 5432/5433. Change it here and in DATABASE_URL together.
POSTGRES_PORT=5434
